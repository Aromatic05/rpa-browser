{
    "name": "rpa-extension-monorepo",
    "private": true,
    "packageManager": "pnpm@11.0.9",
    "scripts": {
        "dev:agent": "pnpm --filter ./agent dev:hot",
        "dev:cdp": "exec node scripts/dev_runtime.mjs --mode=cdp",
        "dev:mcp": "pnpm --filter ./agent mcp:hot",
        "build:extension": "node scripts/build_extensions.mjs",
        "dev": "exec node scripts/dev_runtime.mjs --mode=extension",
        "dev:headless": "pnpm build:extension && pnpm --filter ./agent dev:headless",
        "mcp": "pnpm --filter ./agent mcp",
        "mcp:hot": "pnpm --filter ./agent mcp:hot",
        "setup": "pnpm -r install && pnpm exec playwright install chromium",
        "pw:install": "pnpm --filter ./agent exec playwright install chromium",
        "test:agent": "pnpm --filter ./agent test",
        "test:agent:headed": "pnpm --filter ./agent test:headed",
        "test:agent:smoke:mcp": "pnpm --filter ./agent test:smoke:mcp",
        "test:extension": "pnpm --filter ./extension test",
        "test:dev-cdp": "node --test scripts/__tests__/dev_cdp_runtime.test.mjs scripts/__tests__/dev_runtime_contract.test.mjs",
        "typecheck:agent": "pnpm --filter ./agent typecheck",
        "typecheck:extension": "pnpm --filter ./extension typecheck",
        "typecheck": "pnpm typecheck:agent && pnpm typecheck:extension",
        "lint": "pnpm exec eslint \"agent/**/*.{ts,tsx,js,jsx,mjs,cjs}\" \"extension/**/*.{ts,tsx,js,jsx,mjs,cjs}\" \"start_extension/**/*.{ts,tsx,js,jsx,mjs,cjs}\" --max-warnings=0",
        "format": "npx prettier --write \"**/*.{ts,tsx,js,jsx,css,md,json,html}\"",
        "control": "pnpm --filter ./agent control",
        "test:repo-contract": "node --test scripts/__tests__/repository_contract.test.mjs",
        "test:agent:snapshot": "pnpm --filter ./agent test:snapshot",
        "test:agent:entity-rules": "pnpm --filter ./agent test:entity-rules",
        "test": "pnpm test:repo-contract && pnpm typecheck && pnpm lint && pnpm --filter ./agent test:ci && pnpm test:extension && pnpm test:dev-cdp"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.19.7",
        "@typescript-eslint/eslint-plugin": "^8.54.0",
        "@typescript-eslint/parser": "^8.54.0",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^4.2.1",
        "playwright": "^1.57.0",
        "prettier": "^2.8.8",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.59.0"
    }
}
