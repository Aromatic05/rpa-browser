{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": ["chrome", "node"],
        "skipLibCheck": true
    },
    "include": ["src/annotator/**/*.ts", "src/annotator/**/*.vue"],
    "exclude": ["src/annotator/__tests__/**"]
}
