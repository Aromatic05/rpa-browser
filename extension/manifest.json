{
    "manifest_version": 3,
    "name": "RPA Browser",
    "version": "0.1.0",
    "description": "Program-first browser automation with teachable page knowledge and transactional agent execution.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "tabs",
        "windows"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_title": "RPA Browser"
    },
    "chrome_url_overrides": {
        "newtab": "newtab.html"
    },
    "content_security_policy": {
        "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:* ws://localhost:*"
    },
    "background": {
        "service_worker": "entry/sw.js",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "entry/content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "shared/*.js",
                "content/*.js",
                "annotator/*.js",
                "product/*.js",
                "rpa-build.json"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}
