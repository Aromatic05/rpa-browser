{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmitOnError": true,
        "rootDir": "src",
        "outDir": "dist",
        "lib": [
            "ES2022",
            "DOM"
        ],
        "types": [
            "chrome"
        ]
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "src/annotator/App.vue",
        "src/annotator/main.ts",
        "src/**/*.test.ts",
        "src/**/__tests__/**"
    ]
}
