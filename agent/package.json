{
    "name": "rpa-agent",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.19.0"
    },
    "scripts": {
        "dev": "tsx src/app/entrypoints/agent.ts",
        "dev:headless": "RPA_HEADLESS=true pnpm dev",
        "dev:cdp": "RPA_BROWSER_MODE=cdp tsx src/app/entrypoints/agent.ts",
        "dev:watch": "tsx watch src/app/entrypoints/agent.ts",
        "dev:hot": "concurrently -k \"pnpm test:runner:bundle:watch\" \"pnpm dev\"",
        "build:runner": "esbuild src/automation/runner/plugin_entry.ts --bundle --format=esm --platform=node --packages=external --outfile=.runner-dist/plugin.mjs --sourcemap",
        "build:recorder-payload": "esbuild src/automation/recording/capture/payload/index.ts --bundle --format=iife --platform=browser --target=es2018 --outfile=src/automation/recording/capture/payload.bundle.js --sourcemap",
        "build:app": "pnpm build:recorder-payload && esbuild src/app/entrypoints/agent.ts --bundle --format=esm --platform=node --packages=external --outfile=.dist/agent.mjs --sourcemap && node scripts/copy_product_assets.mjs",
        "build:product": "pnpm build:runner && pnpm build:app",
        "mcp": "tsx src/app/entrypoints/mcp.ts",
        "mcp:dev": "tsx watch src/app/entrypoints/mcp.ts",
        "mcp:hot": "concurrently -k \"pnpm test:runner:bundle:watch\" \"pnpm mcp:dev\"",
        "control": "tsx src/app/entrypoints/control.ts",
        "test:runner:bundle": "pnpm build:runner",
        "test:runner:bundle:watch": "esbuild src/automation/runner/plugin_entry.ts --bundle --format=esm --platform=node --packages=external --outfile=.runner-dist/plugin.mjs --sourcemap --watch",
        "test:unit": "node scripts/run_tests_isolated.mjs --import tsx --test \"tests/integration/agent/**/*.test.ts\" \"tests/integration/compute/**/*.test.ts\" \"tests/integration/config/**/*.test.ts\" \"tests/integration/control/**/*.test.ts\" \"tests/integration/dsl/**/*.test.ts\" \"tests/integration/mcp/**/*.test.ts\" \"tests/integration/workflow/**/*.test.ts\" \"tests/integration/runner/checkpoint/**/*.test.ts\" \"tests/integration/runner/hotreload/**/*.test.ts\" \"tests/integration/runner/steps/**/*.test.ts\" \"tests/integration/runner/trace/runtime/**/*.test.ts\" tests/integration/protocol_stream.test.ts",
        "test:integration:run": "pnpm test:runner:bundle && pnpm -C .. build:extension && node scripts/run_tests_isolated.mjs --import tsx --test --test-concurrency=8 \"tests/integration/**/*.test.ts\"",
        "test:integration": "RPA_INTEGRATION_HEADED=false pnpm test:integration:run",
        "test:integration:headed": "RPA_INTEGRATION_HEADED=true pnpm test:integration:run",
        "test:e2e": "RPA_E2E_HEADED=0 pnpm test:e2e:run",
        "test:runner": "node scripts/run_tests_isolated.mjs --import tsx --test \"tests/integration/runner/**/*.test.ts\"",
        "test:trace": "node scripts/run_tests_isolated.mjs --import tsx --test \"tests/integration/trace/**/*.test.ts\"",
        "test:smoke:mcp": "tsx scripts/mcp_smoke_client.ts",
        "eval:agent:live": "tsx tests/live/agent/program_vs_baseline.ts",
        "eval:agent:rollback": "tsx tests/live/agent/failure_rollback.ts",
        "eval:agent:side-effect-error": "tsx tests/live/agent/side_effect_error.ts",
        "test:unit:snapshot:perf": "SNAPSHOT_V2_PERF_BASELINE=1 node scripts/run_tests_isolated.mjs --import tsx --test tests/integration/runner/steps/snapshot_performance_baseline.test.ts",
        "snapshot:v2:capture-framework-fixtures": "tsx scripts/snapshot_v2_capture_framework_fixtures.ts",
        "snapshot:v2:stage1-baseline": "tsx scripts/snapshot_v2_stage1_baseline.ts",
        "test:all": "pnpm test:e2e && pnpm test:runner && pnpm test:trace && pnpm test:unit",
        "test:ci": "pnpm test:integration",
        "typecheck": "tsc --noEmit",
        "pw:install": "pnpm exec playwright install chromium",
        "test": "pnpm test:all",
        "test:headed": "playwright test tests/e2e --pass-with-no-tests --headed",
        "test:e2e:run": "pnpm test:runner:bundle && pnpm -C .. build:extension && playwright test tests/e2e --workers=4",
        "test:e2e:headed": "RPA_E2E_HEADED=1 pnpm test:e2e:run --headed",
        "typecheck:snapshot": "tsc -p tsconfig.snapshot.json",
        "test:snapshot": "node scripts/run_tests_isolated.mjs --import tsx --test --test-concurrency=8 \"tests/integration/snapshot/**/*.test.ts\"",
        "snapshot:v2:stage2-baseline": "tsx scripts/snapshot_v2_stage2_baseline.ts",
        "snapshot:v2:capture-form-fixtures": "tsx scripts/snapshot_v2_capture_form_fixtures.ts",
        "snapshot:v2:stage3-baseline": "tsx scripts/snapshot_v2_stage3_baseline.ts",
        "test:entity-rules": "node scripts/run_tests_isolated.mjs --import tsx --test --test-concurrency=8 \"tests/integration/entity_rules/**/*.test.ts\"",
        "test:unit:snapshot:full-perf": "SNAPSHOT_V2_FULL_PERF_BASELINE=1 node scripts/run_tests_isolated.mjs --import tsx --test tests/integration/runner/steps/snapshot_full_pipeline_performance.test.ts",
        "snapshot:v2:stage45-perf-baseline": "tsx scripts/snapshot_v2_stage45_performance_baseline.ts"
    },
    "dependencies": {
        "@axe-core/playwright": "^4.10.2",
        "@earendil-works/pi-agent-core": "0.83.0",
        "@earendil-works/pi-ai": "0.83.0",
        "@modelcontextprotocol/sdk": "1.0.0",
        "chokidar": "^3.6.0",
        "playwright": "^1.57.0",
        "ws": "^8.19.0",
        "yaml": "2.8.1",
        "zod": "3.23.8"
    },
    "devDependencies": {
        "@playwright/test": "^1.57.0",
        "@types/node": "^22.19.19",
        "@types/ws": "^8.5.10",
        "antd": "^5.29.3",
        "concurrently": "^9.2.1",
        "element-plus": "^2.13.7",
        "esbuild": "^0.25.0",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "tsx": "^4.20.5",
        "typescript": "^5.9.2"
    }
}
